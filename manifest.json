{
  "manifest_version": "0.3",
  "name": "nasa-power-mcp-server",
  "version": "0.1.0",
  "description": "Query NASA POWER solar, wind, building, and agroclimatology data via MCP. STDIO or Streamable HTTP.",
  "author": { "name": "cyanheads" },
  "repository": { "type": "git", "url": "https://github.com/cyanheads/nasa-power-mcp-server" },
  "homepage": "https://github.com/cyanheads/nasa-power-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "CANVAS_PROVIDER_TYPE": "none",
        "CANVAS_DEFAULT_MEMORY_LIMIT_MB": "256",
        "CANVAS_MAX_CANVASES_PER_TENANT": "4",
        "CANVAS_TTL_MS": "3600000",
        "CANVAS_ABSOLUTE_CAP_MS": "21600000",
        "NASA_POWER_DATAFRAME_DROP_ENABLED": "${user_config.NASA_POWER_DATAFRAME_DROP_ENABLED}",
        "MCP_LOG_LEVEL": "${user_config.MCP_LOG_LEVEL}",
        "NODE_ENV": "production"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "NASA_POWER_DATAFRAME_DROP_ENABLED": {
      "type": "string",
      "title": "Enable dataframe removal",
      "description": "Expose explicit staged-table removal (true or false). The portable bundle remains inline-only.",
      "default": "false"
    },
    "MCP_LOG_LEVEL": {
      "type": "string",
      "title": "Log level",
      "description": "Minimum log level for output.",
      "default": "info"
    }
  }
}
