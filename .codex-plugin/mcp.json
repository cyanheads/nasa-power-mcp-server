{
  "nasa-power-mcp-server": {
    "command": "npx",
    "args": ["-y", "@cyanheads/nasa-power-mcp-server"],
    "env": {
      "MCP_TRANSPORT_TYPE": "stdio",
      "CANVAS_DEFAULT_MEMORY_LIMIT_MB": "256",
      "CANVAS_MAX_CANVASES_PER_TENANT": "4",
      "CANVAS_TTL_MS": "3600000",
      "CANVAS_ABSOLUTE_CAP_MS": "21600000"
    },
    "env_vars": ["CANVAS_PROVIDER_TYPE", "NASA_POWER_DATAFRAME_DROP_ENABLED", "MCP_LOG_LEVEL"]
  }
}
