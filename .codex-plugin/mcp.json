{
  "nasa-power-mcp-server": {
    "command": "npx",
    "args": ["-y", "@cyanheads/nasa-power-mcp-server"],
    "env": {
      "MCP_TRANSPORT_TYPE": "stdio"
    },
    "env_vars": ["CANVAS_PROVIDER_TYPE", "CANVAS_DEFAULT_MEMORY_LIMIT_MB", "CANVAS_MAX_CANVASES_PER_TENANT", "CANVAS_TTL_MS", "CANVAS_ABSOLUTE_CAP_MS", "NASA_POWER_MAX_CANVASES_PER_PROCESS", "NASA_POWER_DATAFRAME_DROP_ENABLED", "MCP_LOG_LEVEL"]
  }
}
