{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nasa-power-mcp-server",
  "version": "0.1.0",
  "description": "Query NASA POWER solar, wind, building, and agroclimatology data via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/nasa-power-mcp-server#readme",
  "repository": "https://github.com/cyanheads/nasa-power-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol"],
  "mcpServers": {
    "nasa-power-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/nasa-power-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
